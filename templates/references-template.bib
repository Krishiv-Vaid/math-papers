% =====================================================================
%  references-template.bib: example entry types for math-papers
%
%  Rules:
%   * Cite only sources that exist and that you have checked.
%   * Do not guess volume, issue or page numbers. Omit unknown fields and
%     add a `note` saying what is unverified.
%   * Mark preprints, repositories and forum posts as unrefereed in `note`.
%   * Include an MR number or DOI where available.
% =====================================================================

@article{AuthorYYYYKey,
  author  = {Lastname, Firstname and Lastname, Firstname},
  title   = {Title of the Article},
  journal = {Full Journal Name},
  volume  = {00},
  number  = {0},
  year    = {YYYY},
  pages   = {1--20},
  doi     = {10.xxxx/xxxxx},
  note    = {MR 0000000}
}

@book{AuthorYYYYBook,
  author    = {Lastname, Firstname},
  title     = {Title of the Book},
  edition   = {Second},
  series    = {Series Name},
  publisher = {Publisher},
  address   = {City},
  year      = {YYYY}
}

@incollection{AuthorYYYYChapter,
  author    = {Lastname, Firstname},
  title     = {Title of the Chapter},
  booktitle = {Title of the Edited Volume},
  editor    = {Lastname, Firstname},
  publisher = {Publisher},
  address   = {City},
  year      = {YYYY},
  pages     = {100--120}
}

@misc{AuthorYYYYarXiv,
  author       = {Lastname, Firstname},
  title        = {Title of the Preprint},
  year         = {YYYY},
  howpublished = {arXiv:YYMM.NNNNN [math.NT]},
  note         = {Preprint, unrefereed}
}

@phdthesis{AuthorYYYYThesis,
  author = {Lastname, Firstname},
  title  = {Title of the Thesis},
  school = {University},
  year   = {YYYY}
}

@misc{BloomNNN,
  author       = {Bloom, Thomas F.},
  title        = {Erd{\H{o}}s Problem \#NNN},
  howpublished = {\url{https://www.erdosproblems.com/NNN}},
  note         = {Accessed YYYY-MM-DD}
}

@misc{OEIS_Axxxxxx,
  author       = {{OEIS Foundation Inc.}},
  title        = {Sequence {Axxxxxx}: <name>},
  howpublished = {The On-Line Encyclopedia of Integer Sequences, \url{https://oeis.org/Axxxxxx}},
  note         = {Accessed YYYY-MM-DD}
}

@misc{RepoYYYY,
  author       = {Lastname, Firstname},
  title        = {Repository Name},
  year         = {YYYY},
  howpublished = {\url{https://github.com/owner/repo}},
  note         = {Software repository; commit <hash>. Unrefereed}
}
